{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.2-contributor-free",
  "provider": {
    "openai": {
      "baseURL": "https://opencode.ai/zen/v1",
      "apiKey": "{env:OPENCODE_API_KEY}"
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    },
    "openai": {
      "type": "remote",
      "url": "https://opencode.ai/zen/v1/mcp/",
      "enabled": true
    },
    "local": {
      "type": "remote",
      "url": "",
      "enabled": true
    }
  },
  "lsp": true,
  "permission": {
    "read": "allow",
    "write": "allow",
    "bash": "allow"
  }
}