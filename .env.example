# LLM — OpenRouter (single canonical provider)
# Obtain key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER=openrouter

# OCR — Amazon Textract (async PDF) — REAL infrastructure, no mock fallback in prod
# Primary OCR provider. Use "textract" for production, "mock" ONLY for tests (vitest).
OCR_PROVIDER=textract
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=veda-ai-documents
# Optional: separate bucket for Textract output artifacts (defaults to AWS_S3_BUCKET)
AWS_TEXTRACT_OUTPUT_BUCKET=
AWS_S3_INPUT_PREFIX=ocr-input
AWS_S3_OUTPUT_PREFIX=ocr-output
# Optional async orchestration via SNS/SQS (if not set, polling is used)
AWS_SNS_TOPIC_ARN=
AWS_SNS_ROLE_ARN=
AWS_SQS_QUEUE_URL=
OCR_OPERATION_TIMEOUT_MS=300000
OCR_POLL_INTERVAL_MS=5000
OCR_MAX_RETRIES=3

# Vision — parallel to Textract (evidence-only, grounded to Textract geometry)
# Uses OPENROUTER_API_KEY by fallback; no separate VISION_API_KEY needed
VISION_PROVIDER=auto
VISION_MAX_PAGES=3
VISION_TIMEOUT_MS=30000

# Mapping thresholds (single source; empirical calibration needed)
MAPPING_HIGH_THRESHOLD=0.75
MAPPING_REVIEW_THRESHOLD=0.50

# Limits
MAX_FILE_SIZE_MB=100
MAX_PAGES=50
MAX_CONCURRENT_AI=2

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Guest
GUEST_RESULT_GRACE_PERIOD_MS=90000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
