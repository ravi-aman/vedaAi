# Application AI
AI_PROVIDER=opencode-zen
AI_MODEL=muse-spark-1.2-contributor-free
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/v1

# OCR — Google Cloud Vision DOCUMENT_TEXT_DETECTION (async PDF)
# Primary OCR provider. Use "google-vision" for production, "mock" for tests/local without GCP.
OCR_PROVIDER=google-vision
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_OCR_INPUT_PREFIX=ocr-input
GOOGLE_CLOUD_OCR_OUTPUT_PREFIX=ocr-output
# Auth: prefer GOOGLE_APPLICATION_CREDENTIALS file path (ADC). For platforms without file, use JSON string:
# GOOGLE_CLOUD_KEY_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
OCR_OPERATION_TIMEOUT_MS=300000
OCR_POLL_INTERVAL_MS=5000
OCR_MAX_RETRIES=3

# Mapping thresholds (single source; empirical calibration needed)
MAPPING_HIGH_THRESHOLD=0.75
MAPPING_REVIEW_THRESHOLD=0.50

# Limits
MAX_FILE_SIZE_MB=100
MAX_PAGES=50
MAX_CONCURRENT_AI=2

# OpenCode coding-agent configuration (separate from app runtime)
OPENCODE_DEFAULT_MODEL=muse-spark-1.2-contributor-free
OPENCODE_API_KEY=
OPENCODE_API_BASE=https://opencode.ai/zen/v1

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Guest
GUEST_RESULT_GRACE_PERIOD_MS=90000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
