# Application AI — fetched from https://opencode.ai/zen/v1/models (free tier)
# Verified 2026-08-27 via chat/completions (responses 500 for all except muse-spark):
# laguna-s-2.1-free (200 in 3.7s, clean JSON) ← primary
# nemotron-3.5-lightning-free (200 in 18s, verbose)
# nemotron-3-ultra-free (502 overloaded 49s, fallback)
# Rate-limited: muse-spark-1.2-contributor-free (429), mimo-v2.5-free (429), hy3-free (429)
# Unavailable: deepseek-v4-flash-free (500)
AI_PROVIDER=opencode-zen
AI_MODEL=laguna-s-2.1-free
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/v1

# OCR — Amazon Textract (async PDF) — REAL infrastructure, no mock fallback in prod
# Primary OCR provider. Use "textract" for production, "mock" ONLY for tests (vitest).
OCR_PROVIDER=textract
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=veda-ai-documents
# Optional: separate bucket for Textract output artifacts (defaults to AWS_S3_BUCKET)
AWS_TEXTRACT_OUTPUT_BUCKET=
AWS_S3_INPUT_PREFIX=ocr-input
AWS_S3_OUTPUT_PREFIX=ocr-output
# Optional async orchestration via SNS/SQS (if not set, polling is used)
AWS_SNS_TOPIC_ARN=
AWS_SNS_ROLE_ARN=
AWS_SQS_QUEUE_URL=
OCR_OPERATION_TIMEOUT_MS=300000
OCR_POLL_INTERVAL_MS=5000
OCR_MAX_RETRIES=3

# Mapping thresholds (single source; empirical calibration needed)
MAPPING_HIGH_THRESHOLD=0.75
MAPPING_REVIEW_THRESHOLD=0.50

# Limits
MAX_FILE_SIZE_MB=100
MAX_PAGES=50
MAX_CONCURRENT_AI=2

# OpenCode coding-agent configuration (separate from app runtime)
OPENCODE_DEFAULT_MODEL=nemotron-3-ultra-free
OPENCODE_API_KEY=
OPENCODE_API_BASE=https://opencode.ai/zen/v1

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Guest
GUEST_RESULT_GRACE_PERIOD_MS=90000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
