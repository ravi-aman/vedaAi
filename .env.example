# ============================================================
# APPLICATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
GUEST_RESULT_GRACE_PERIOD_MS=90000

# ============================================================
# STORAGE — Supabase (SaaS)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OCR — Local PaddleOCR (PP-StructureV3) — Active provider
# ============================================================
OCR_PROVIDER=local
LOCAL_OCR_ENGINE=paddleocr
LOCAL_OCR_PIPELINE=pp_structure_v3
LOCAL_OCR_DEVICE=cpu
LOCAL_OCR_CONCURRENCY=2
LOCAL_OCR_LANGUAGE=en
LOCAL_OCR_VERSION=PP-OCRv5
LOCAL_OCR_PYTHON=python
LOCAL_OCR_TIMEOUT_MS=600000
OCR_OPERATION_TIMEOUT_MS=300000
OCR_POLL_INTERVAL_MS=5000
OCR_MAX_RETRIES=3
# Legacy Textract (deprecated, keep only if rollback needed)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=veda-ai-documents
# AWS_TEXTRACT_OUTPUT_BUCKET=
# AWS_S3_INPUT_PREFIX=ocr-input
# AWS_S3_OUTPUT_PREFIX=ocr-output
# AWS_SNS_TOPIC_ARN=
# AWS_SNS_ROLE_ARN=
# AWS_SQS_QUEUE_URL=

# ============================================================
# VISION PROVIDER SELECTION
# ============================================================
VISION_PROVIDER_ORDER=openrouter,opencode,nvidia
VISION_AUTO_FALLBACK=true

# ============================================================
# OPENROUTER — PRIMARY (proven qwen3-vl-32b)
# ============================================================
# Obtain key: https://openrouter.ai/keys
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct
OPENROUTER_MAX_CONCURRENCY=1

# ============================================================
# OPENCODE — TERTIARY FREE (mimo-v2.5-free)
# ============================================================
# OpenCode Zen key: https://opencode.ai/workspace/.../billing
OPENCODE_ENABLED=true
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_VISION_MODEL=mimo-v2.5-free
OPENCODE_MAX_CONCURRENCY=1

# ============================================================
# NVIDIA — PAID FALLBACK (https://build.nvidia.com)
# ============================================================
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_MAX_CONCURRENCY=1

# ============================================================
# VISION RUNTIME — global
# ============================================================
VISION_GLOBAL_CONCURRENCY=1
VISION_BATCH_SIZE=3
VISION_TIMEOUT_MS=90000
VISION_MAX_RETRIES=1
VISION_MAX_ADJUDICATIONS=6
VISION_MAX_PAGES=50
# Deprecated legacy (use VISION_PROVIDER_ORDER instead):
# VISION_PROVIDER=auto

# ============================================================
# MAPPING
# ============================================================
MAPPING_HIGH_THRESHOLD=0.75
MAPPING_REVIEW_THRESHOLD=0.5

# ============================================================
# LIMITS
# ============================================================
MAX_FILE_SIZE_MB=100
MAX_PAGES=50
MAX_CONCURRENT_AI=2

# ============================================================
# PROCESSING BACKEND — Vercel compatibility (Phase 9)
# ============================================================
# local = run PaddleOCR/Vision in-process (npm run dev, worker container)
# remote = Vercel enqueues to Supabase, external worker processes
PROCESSING_BACKEND=local
# Only needed when PROCESSING_BACKEND=remote
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_STALE_TIMEOUT_MS=120000
WORKER_POLL_INTERVAL_MS=5000
# Optional: push worker URL for immediate dispatch (when remote)
# WORKER_URL=https://worker.example.com
# WORKER_TOKEN=secret-shared-token
