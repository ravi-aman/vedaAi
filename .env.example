# Application runtime AI config (server-only, never NEXT_PUBLIC)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=

# Thresholds (optional)
MAPPING_HIGH_THRESHOLD=0.75
MAPPING_REVIEW_THRESHOLD=0.5

# Limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=50

# Coding-agent compatibility (not app creds; see opencode.json)
OPENCODE_DEFAULT_MODEL=muse-spark-1.2-contributor-free
OPENCODE_API_KEY=
OPENCODE_API_BASE=
